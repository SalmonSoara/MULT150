  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1 - directional light modifications: Color changed to orange, intensity:
    .8, rotation 50, -30, 0.\r\n\r\n2 - fog modifications: green color, density:
    .04, exponential squared mode.\r\n\r\n3 - skybox modifications: atmosphere thickness:
    .17, exposure: 1.1, sky tint: green, simple sun, sun size 17.\r\n\n4 - OBSTACLE
    PREFAB\r:                                       add or modify light component
    (colour, range, intensity, etc)\r\nmodifications: range: 2.5, intensity 3, kept
    the same red.\r\n\r\n5 - POWERUP PREFAB: replace with a new complex object comprised
    of 3 or more shapes (different from previously made object)\r\nmodifications:
    Created a battery-like shape \r\n\n6 - use gameobject hierarchy to keep the powerup
    prefab organised\r\n   [no record necessary]\n\n7 - apply at least 2 new textures\r                                                   
    (add source url or package name)\r                                                                                                          
    texture source 1: black_diamonds.jpg\r                                                                                                                                                                       
    texture source 2: green_fabric.jpg \r\n         (photos I took)\r\n\r\n8 - add
    particle system component and customise at least 3 parameters\r\nparameter 1:
    rotation by speed, angular velocity: 60\r\nparameter 2: Ribbon trails, 1 count,
    inherit particle color\r\nparameter 3: green start color\r\n\r\n\r\n9 - WALL:
    convert a wall to prefab, create a variant, and use the variant to replace the
    other wall in the scene\r                                                                                                                                                                             
    [no record necessary]\r\n\r10 - WALL: modify wall prefab material tint so that
    the 2 walls are different in appearance or colour\r                                                                                                                                                             
    [no record necessary]"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
